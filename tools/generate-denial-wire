#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$ROOT/protocol/FLATBUFFERS_VERSION")"
DART_OUT="$ROOT/protocol/generated/dart"
RUST_OUT="$ROOT/protocol/generated/rust"
MODE="${1:-generate}"

if [[ "$MODE" != "generate" && "$MODE" != "--check" ]]; then
    printf 'Usage: %s [--check]\n' "$0" >&2
    exit 2
fi

FLATC_BIN="${FLATC:-}"
if [[ -z "$FLATC_BIN" ]]; then
    FLATC_BIN="$(command -v flatc || true)"
fi
if [[ -z "$FLATC_BIN" || ! -x "$FLATC_BIN" ]]; then
    printf 'flatc %s is required; set FLATC to the matching executable\n' "$VERSION" >&2
    exit 1
fi

ACTUAL_VERSION="$($FLATC_BIN --version | awk '{print $NF}')"
if [[ "$ACTUAL_VERSION" != "$VERSION" ]]; then
    printf 'flatc version mismatch: need %s, found %s at %s\n' \
        "$VERSION" "$ACTUAL_VERSION" "$FLATC_BIN" >&2
    exit 1
fi

TMP="$(mktemp -d)"
trap 'rm -rf -- "$TMP"' EXIT
mkdir -p "$TMP/dart" "$TMP/rust"

# Every schema under protocol/ participates in the same pinned flow. flatc
# derives each output name from the schema stem, so stems must stay unique.
shopt -s nullglob
SCHEMAS=("$ROOT"/protocol/*.fbs)
if [[ ${#SCHEMAS[@]} -eq 0 ]]; then
    printf 'no schemas found under %s/protocol\n' "$ROOT" >&2
    exit 1
fi

for SCHEMA in "${SCHEMAS[@]}"; do
    "$FLATC_BIN" --dart --warnings-as-errors -o "$TMP/dart" "$SCHEMA"
    "$FLATC_BIN" --rust --warnings-as-errors -o "$TMP/rust" "$SCHEMA"
done

if [[ "$MODE" == "--check" ]]; then
    for GENERATED in "$TMP"/dart/*.dart; do
        cmp "$DART_OUT/lib/$(basename -- "$GENERATED")" "$GENERATED"
    done
    for GENERATED in "$TMP"/rust/*.rs; do
        cmp "$RUST_OUT/$(basename -- "$GENERATED")" "$GENERATED"
    done
    for COMMITTED in "$DART_OUT"/lib/*.dart; do
        cmp "$COMMITTED" "$TMP/dart/$(basename -- "$COMMITTED")"
    done
    for COMMITTED in "$RUST_OUT"/*.rs; do
        cmp "$COMMITTED" "$TMP/rust/$(basename -- "$COMMITTED")"
    done
    printf 'Denial generated wire code is current (FlatBuffers %s)\n' "$VERSION"
    exit 0
fi

mkdir -p "$DART_OUT/lib" "$RUST_OUT"
for GENERATED in "$TMP"/dart/*.dart; do
    cp "$GENERATED" "$DART_OUT/lib/$(basename -- "$GENERATED")"
done
for GENERATED in "$TMP"/rust/*.rs; do
    cp "$GENERATED" "$RUST_OUT/$(basename -- "$GENERATED")"
done
printf 'generated Denial wire code with FlatBuffers %s\n' "$VERSION"
